APP_ENV=dev
VENDURE_SERVER_PORT=3001
COOKIE_SECRET=cambia-este-secreto
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=superadmin
# Comma-separated list of browser origins allowed to make credentialed API requests,
# e.g. https://example.com,https://admin.example.com
# Only used when APP_ENV is not "dev". Leave empty in local development.
CORS_ORIGINS=
DB_HOST=localhost
DB_PORT=6543
DB_NAME=vendure
DB_USERNAME=vendure
DB_PASSWORD=vendure
DB_SCHEMA=public
# Correos transaccionales por Resend (pedidos, verificación, reset, etc.).
# Sin RESEND_API_KEY no se envía nada: en dev van al mailbox, en prod a disco.
# Consigue la key en https://resend.com/api-keys y verifica el dominio en https://resend.com/domains
RESEND_API_KEY=
# Remitente que ven los clientes. Debe ser un dominio verificado en Resend, ej. '"Dulcería Alegría" <pedidos@tu-dominio.com>'
EMAIL_FROM_ADDRESS=
# URL pública del storefront, usada en los enlaces de los correos
STOREFRONT_URL=http://localhost:3002
# URL pública de este servidor (solo producción), ej. https://api.tu-dominio.com
# Define las URLs de los assets y el enlace de reset de contraseña del Dashboard.
PUBLIC_URL=
