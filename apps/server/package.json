    "search:terms": "ts-node src/reporte-terminos.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/graphql": "14.0.3",
    "@vendure/asset-server-plugin": "3.8.1",
    "@vendure/core": "3.8.1",
    "@vendure/dashboard": "3.8.1",
    "@vendure/email-plugin": "3.8.1",
    "@vendure/graphiql-plugin": "3.8.1",
    "dotenv": "18.0.9",
    "graphql-tag": "2.12.7",
    "pg": "8.23.1",
    "resend": "^6.37.0",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@vendure/cli": "3.8.1",
    "ts-node": "10.9.2",
