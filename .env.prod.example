# Variables de producción para docker-compose.prod.yml.
#   cp .env.prod.example .env.prod
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build postgres server worker
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build storefront
# .env.prod contiene secretos: no lo subas al repositorio.

# --- Obligatorias ---------------------------------------------------------
# Secreto de las cookies de sesión. Genera uno con: openssl rand -base64 32
COOKIE_SECRET=
# Credenciales del superadmin. Solo se aplican la PRIMERA vez que se crea la base de datos;
# después, cambia la contraseña desde el Dashboard. No uses "superadmin" (Vendure no arranca).
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=
# Contraseña de PostgreSQL (el servicio postgres y Vendure la leen de aquí).
DB_PASSWORD=
# URL pública del server, sin "/" final. Define las URLs de los assets y el reset de contraseña del Dashboard.
PUBLIC_URL=https://api.tu-dominio.com
# URL pública del storefront: se usa en los enlaces de los correos.
STOREFRONT_URL=https://tu-dominio.com

# --- Recomendadas ---------------------------------------------------------
# Orígenes (separados por comas) que pueden llamar a la API desde el navegador. Vacío = ninguno.
# El Dashboard va en el mismo origen que la API, así que no lo necesita.
CORS_ORIGINS=https://tu-dominio.com
# Correos transaccionales por Resend. Sin RESEND_API_KEY no se envía ningún correo.
RESEND_API_KEY=
# Remitente, dominio verificado en Resend. Ej: "Dulcería Alegría" <pedidos@tu-dominio.com>
EMAIL_FROM_ADDRESS=

# --- Tienda (Next.js) -------------------------------------------------------
# Nombre y datos de contacto del pie de página. Los vacíos no se muestran.
# Se incrustan al construir la imagen: tras cambiarlos hay que reconstruir (re-ejecutar el deploy).
# SITE_NAME=Dulcería Alegría
# CONTACT_PHONE=
# CONTACT_EMAIL=
# CONTACT_ADDRESS=
# CONTACT_HOURS=
# Solo si usas el webhook de revalidación (POST /api/revalidate con "Authorization: Bearer <valor>").
# REVALIDATION_SECRET=

# --- Opcionales (valores por defecto) --------------------------------------
# DB_NAME=vendure
# DB_USERNAME=vendure
# Puerto/interfaz en el host donde se publica el server (por defecto 127.0.0.1:3001).
# SERVER_PORT=3001
# SERVER_BIND=127.0.0.1
# Ídem para la tienda (por defecto 127.0.0.1:3002).
# STOREFRONT_PORT=3002
# STOREFRONT_BIND=127.0.0.1
# Etiqueta de la imagen (útil para volver a una versión anterior).
# IMAGE_TAG=latest
